cabal-version:      3.0
name:               raytracer
version:            0.1.0.0
synopsis:           Simple raytracer written in Haskell
description:        Simple raytracer written in Haskell
license:            MIT
license-file:       LICENSE
author:             Preston Corless
maintainer:         pgattic@gmail.com

-- A copyright notice.
-- copyright:

build-type:         Simple
extra-doc-files:    README.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Bounds, Optics, Sampling, Camera, Color, Image, Interval, Point3, Light, Ray, Renderer, Scene, Vec3,
                      Objects.HitRecord,
                      Objects.Material,
                      Objects.Object,
                      Objects.Sphere,
                      Objects.Triangle
    build-depends:    base ^>=4.20.2.0
    default-language: Haskell2010

executable raytracer
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:    Scenes
    build-depends:    base ^>=4.20.2.0, raytracer
    default-language: Haskell2010

test-suite raytracer-tests
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    build-depends: base ^>=4.20.2.0, raytracer
    default-language: Haskell2010
